// Compatibility pieces for the Android 4.4 era vendor blobs on Android 16.

// The blobs need libstdc++.so, which is not LL-NDK any more; Android ships
// a vendor copy named libstdc++_vendor.so, so expose it under the old name.
install_symlink {
    name: "libstdc++_vendor_compat_symlink",
    soc_specific: true,
    installed_location: "lib/libstdc++.so",
    symlink_target: "libstdc++_vendor.so",
}

// libcneapiclient (needed by netmgrd for mobile data) links
// libcnefeatureconfig only for isFeatureEnabled(); report every CNE
// feature as disabled.
cc_library_shared {
    name: "libcnefeatureconfig",
    vendor: true,
    srcs: ["cnefeatureconfig.c"],
}
